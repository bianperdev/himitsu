<!-- Strings of the feat/security track. -->
<resources>
    <string name="security_storage_error_title">無法開啟你的資料</string>
    <string name="security_storage_error_key_file_missing">保護你資料的金鑰檔案遺失。沒有它，加密資料將無法讀取。</string>
    <string name="security_storage_error_key_file_corrupt">保護你資料的金鑰檔案已損毀。</string>
    <string name="security_storage_error_keystore_key_lost">此裝置的安全硬體中已不再有保護你資料的金鑰。這可能發生在某些系統更新或安全性重設之後。如果你儲存了復原碼，現在可以使用它。</string>
    <string name="security_storage_error_keystore_unavailable">此裝置的安全硬體沒有回應。這通常是暫時的。</string>
    <string name="security_storage_error_storage">無法讀取金鑰檔案。請確認裝置有可用空間後再試一次。</string>
    <string name="security_storage_error_migration_failed">無法將現有資料移轉到加密儲存空間。資料仍完好無損。請確認裝置有可用空間後再試一次。</string>
    <string name="security_storage_error_nothing_deleted">沒有刪除任何內容。</string>
    <string name="security_action_retry">重試</string>
    <string name="security_action_use_recovery_code">使用復原碼</string>
    <string name="security_action_start_over">重新開始</string>
    <string name="security_recovery_dialog_title">復原碼</string>
    <string name="security_recovery_dialog_subtitle">輸入你在設定復原時儲存的 28 位復原碼。</string>
    <string name="security_recovery_dialog_label">復原碼</string>
    <string name="security_recovery_dialog_confirm">解鎖</string>
    <string name="security_recovery_error_malformed">這不是有效的復原碼。復原碼由 28 個字母和數字組成。</string>
    <string name="security_recovery_error_wrong">此復原碼無法解鎖你的資料。</string>
    <string name="security_recovery_error_not_configured">這些資料沒有設定復原碼。</string>
    <string name="security_recovery_error_failed">資料已解鎖，但無法儲存新金鑰。請再試一次。</string>
    <string name="security_start_over_title">以空白資料重新開始？</string>
    <string name="security_start_over_message">目前的加密資料（包括圖片）將被移到一旁，應用程式將以空白狀態啟動。不會刪除任何內容。如果這些資料設定過復原碼，之後可以在「隱私權與安全性」的「移到一旁的資料」中還原。</string>
    <string name="security_start_over_confirm">重新開始</string>
    <string name="security_lock_title">已鎖定</string>
    <string name="security_lock_unlock">解鎖</string>
    <string name="security_lock_prompt_title">解鎖</string>
    <string name="security_lock_prompt_subtitle">請驗證身分以繼續</string>
    <string name="security_lock_no_device_lock_title">此裝置未設定螢幕鎖定</string>
    <string name="security_lock_no_device_lock_message">應用程式鎖需要裝置設定 PIN 碼、圖案、密碼或生物辨識。沒有這些，任何拿到手機的人都能開啟應用程式。請在系統設定中設定螢幕鎖定以恢復保護。</string>
    <string name="security_lock_continue_unprotected">在無保護的情況下繼續</string>
    <string name="security_settings_title">隱私權與安全性</string>
    <string name="security_settings_desc">應用程式鎖、復原碼和加密儲存空間</string>
    <string name="security_settings_section_lock">應用程式鎖</string>
    <string name="security_settings_app_lock">鎖定應用程式</string>
    <string name="security_settings_app_lock_desc">開啟應用程式時要求驗證指紋、臉孔或螢幕鎖定</string>
    <string name="security_settings_app_lock_unavailable">請先為此裝置設定螢幕鎖定，才能使用應用程式鎖</string>
    <string name="security_settings_lock_needs_device_lock">請先為此裝置設定螢幕鎖定。</string>
    <string name="security_settings_lock_timeout">離開應用程式後鎖定</string>
    <string name="security_timeout_immediately">立即</string>
    <string name="security_timeout_one_minute">1 分鐘後</string>
    <string name="security_timeout_five_minutes">5 分鐘後</string>
    <string name="security_settings_section_recovery">復原碼</string>
    <string name="security_settings_recovery_create">建立復原碼</string>
    <string name="security_settings_recovery_replace">取代復原碼</string>
    <string name="security_settings_recovery_remove">移除復原碼</string>
    <string name="security_settings_recovery_status_set">已設定復原碼</string>
    <string name="security_settings_recovery_status_none">尚未設定復原碼</string>
    <string name="security_settings_recovery_desc">如果此裝置的安全硬體遺失了保護你資料的金鑰，復原碼是重新開啟資料的唯一方法。</string>
    <string name="security_settings_about_title">受保護的內容</string>
    <string name="security_settings_about_text">聊天、角色、服務供應商、API 金鑰、圖片和頭像都以加密形式儲存在此裝置上。應用程式鎖會在每次開啟應用程式時增加一次驗證。兩者都不會隱藏應用程式已安裝這件事。</string>
    <string name="security_recovery_replace_title">取代復原碼？</string>
    <string name="security_recovery_replace_message">目前的復原碼將失效，並會顯示新的復原碼。</string>
    <string name="security_recovery_remove_title">移除復原碼？</string>
    <string name="security_recovery_remove_message">沒有復原碼時，如果此裝置的安全硬體遺失金鑰，你的資料將無法復原。</string>
    <string name="security_recovery_remove_confirm">移除</string>
    <string name="security_recovery_show_title">你的復原碼</string>
    <string name="security_recovery_show_message">請把它寫下來，保存在遠離這支手機的安全地方。它只會顯示一次。任何擁有此復原碼和應用程式檔案副本的人都可能讀取你的資料。</string>
    <string name="security_recovery_show_confirm">我已記下</string>
    <string name="security_recovery_update_failed">無法更新復原碼。請再試一次。</string>
    <string name="security_settings_section_screen">螢幕</string>
    <string name="security_settings_secure_screen">在螢幕截圖和最近使用中隱藏內容</string>
    <string name="security_settings_secure_screen_desc">封鎖螢幕截圖和螢幕錄影，並在最近使用的應用程式中顯示空白預覽。開啟應用程式鎖後，預覽一律會隱藏；在 Android 12 以下版本，這也會封鎖螢幕截圖。</string>
    <string name="security_cleartext_saved_warning">已儲存。此服務供應商使用未加密的 HTTP：同一網路中的任何人都能讀取你的聊天和 API 金鑰。</string>
    <string name="security_confirm_prompt_title">確認是你本人</string>
    <string name="security_confirm_prompt_subtitle">變更安全設定時需要驗證</string>
    <string name="security_confirm_canceled">未通過確認，未進行任何變更。</string>
    <string name="security_storage_error_plain_unusable">來自舊版應用程式的資料已損毀，無法移入加密儲存空間。你可以儲存一份副本，或將其移到一旁並以空白資料繼續。</string>
    <string name="security_action_set_aside">移到一旁並繼續</string>
    <string name="security_set_aside_title">將損毀的資料移到一旁？</string>
    <string name="security_set_aside_message">損毀的資料及其圖片將被移到一旁，應用程式將以空白資料繼續。不會刪除任何內容，但移到一旁的副本會以未加密形式保留在應用程式的私人儲存空間中，直到你在「隱私權與安全性」中刪除它。</string>
    <string name="security_set_aside_confirm">移到一旁</string>
    <string name="security_action_export">儲存檔案副本</string>
    <string name="security_export_working">正在儲存副本…</string>
    <string name="security_export_title">儲存檔案副本？</string>
    <string name="security_export_message">一個 .zip 檔案將按此裝置上的原樣保存你的檔案。加密的檔案只能用這些資料的復原碼再次開啟，且應用程式目前還無法匯入它們。舊版中尚未加密的資料在副本中同樣未加密。</string>
    <string name="security_export_confirm">選擇儲存位置</string>
    <string name="security_export_done">副本已儲存。</string>
    <string name="security_export_failed">無法儲存副本。你的資料未被變更。</string>
    <string name="security_settings_section_set_aside">移到一旁的資料</string>
    <string name="security_settings_set_aside_desc">「重新開始」或「移到一旁」移開的副本。它們會保留在此裝置上，直到你刪除。</string>
    <string name="security_set_aside_kind_unrecoverable">重新開始時移到一旁</string>
    <string name="security_set_aside_kind_unusable">舊版中損毀的資料（未加密）</string>
    <string name="security_set_aside_kind_replaced">被還原操作取代</string>
    <string name="security_set_aside_details">%1$s · %2$s</string>
    <string name="security_set_aside_delete">永久刪除</string>
    <string name="security_set_aside_delete_title">永久刪除這些資料？</string>
    <string name="security_set_aside_delete_message">這些檔案將從此裝置刪除。此操作無法復原：即使有復原碼也無法找回。</string>
    <string name="security_set_aside_delete_understood">我明白此操作無法復原</string>
    <string name="security_set_aside_delete_confirm">刪除</string>
    <string name="security_set_aside_deleted">已刪除。</string>
    <string name="security_set_aside_delete_failed">部分檔案無法刪除。請再試一次。</string>
    <string name="security_set_aside_restore">還原這些資料</string>
    <string name="security_restore_title">還原這些資料？</string>
    <string name="security_restore_message">你目前的資料將被移到一旁而不會被刪除，此副本將取而代之。應用程式將重新啟動。之後你可以用同樣的方式還原目前的資料。</string>
    <string name="security_restore_confirm">還原</string>
    <string name="security_restore_code_title">此副本的復原碼</string>
    <string name="security_restore_code_subtitle">此裝置的安全硬體已無法開啟此副本。請輸入它原有的復原碼。</string>
    <string name="security_restore_failed">無法還原此副本。未進行任何變更。</string>
    <string name="security_restore_not_configured">此副本沒有復原碼，此裝置也已無法開啟它，因此無法還原。</string>
    <string name="security_storage_error_restore_incomplete">移到一旁的資料的還原尚未完成。請再試一次以重新啟動應用程式並完成還原。</string>
</resources>
