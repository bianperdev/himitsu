    <string name="security_recovery_show_title">복구 코드</string>
    <string name="security_recovery_show_message">적어서 이 휴대전화와 떨어진 안전한 곳에 보관하세요. 한 번만 표시됩니다. 이 코드와 앱 파일 사본을 가진 사람은 누구나 데이터를 읽을 수 있습니다.</string>
    <string name="security_recovery_show_confirm">적어 두었습니다</string>
