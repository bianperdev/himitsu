<resources>
    <!--
      System splash screen (Android 12+). The icon is deliberately not set: the system shows the
      icon of the launcher entry that was tapped, so a disguise alias never reveals the Himitsu logo.
    -->
    <style name="Theme.RPClient" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/himitsu_night</item>
        <item name="android:windowSplashScreenBackground">@color/himitsu_night</item>
    </style>
</resources>
