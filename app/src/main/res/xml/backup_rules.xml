<?xml version="1.0" encoding="utf-8"?>
<!--
    Himitsu (P-03): nothing leaves the device through Android backups. allowBackup is false in
    the manifest; these rules also exclude every domain in case a device or a future setting
    performs a backup anyway. The encrypted databases would be unreadable elsewhere, because
    their key never leaves this device's Keystore, but they are excluded too.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
