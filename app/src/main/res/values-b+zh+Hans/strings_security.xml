    <string name="security_settings_about_title">受保护的内容</string>
    <string name="security_settings_about_text">聊天、角色、服务商、API 密钥、图片和头像都以加密形式保存在此设备上。应用锁会在每次打开应用时增加一次验证。两者都不会隐藏应用已安装这一事实。</string>
    <string name="security_recovery_replace_title">替换恢复码？</string>
    <string name="security_recovery_replace_message">当前恢复码将失效，并会显示新的恢复码。</string>
    <string name="security_recovery_remove_title">移除恢复码？</string>
    <string name="security_recovery_remove_message">没有恢复码时，如果此设备的安全硬件丢失密钥，你的数据将无法恢复。</string>
    <string name="security_recovery_remove_confirm">移除</string>
    <string name="security_recovery_show_title">你的恢复码</string>
    <string name="security_recovery_show_message">请把它写下来，保存在远离这部手机的安全地方。它只会显示一次。任何拥有此恢复码和应用文件副本的人都可能读取你的数据。</string>
    <string name="security_recovery_show_confirm">我已记下</string>
