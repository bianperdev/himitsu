<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- feat/local-inference: model downloads the user starts explicitly -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".RPClientApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RPClient"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".feature.about.AboutActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.licenses.LicensesActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient" />
        <activity
            android:name=".feature.jsonviewer.JsonViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.requestlog.RequestLogActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.tokenusage.TokenUsageActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.regexscript.RegexScriptActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.characteredit.CharacterEditActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.imagecrop.ImageCropActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.llmprovideredit.LLMProviderEditActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.llmproviderlist.LLMProviderListActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.worldbookedit.WorldBookEditActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.worldbookentryedit.WorldBookEntryEditActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.worldbooklist.WorldBookListActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.chat.ChatActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.chatcreate.ChatCreateActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.groupchat.GroupChatActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.groupchatcreate.GroupChatCreateActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.storycreate.StoryCreateActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.storyeditor.StoryEditorActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.characterlist.CharacterListActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.promptpreset.PromptPresetActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize" />
        <!-- feat/disguise: the launcher entry is the HimitsuLauncher alias in the disguise block -->
        <activity
            android:name=".feature.main.MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize" />

        <!-- BEGIN feat/security -->
        <activity
            android:name=".feature.lock.LockActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.lock.settings.SecuritySettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.lock.ConfirmCredentialActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.RPClient.Confirm" />
        <!-- END feat/security -->
        <!-- feat/local-inference -->
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />
        <activity
            android:name=".feature.localmodels.LocalModelsActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient" />
        <service
            android:name=".libs.llm.local.model.LocalModelDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".libs.llm.local.LocalGenerationService"
            android:exported="false"
            android:foregroundServiceType="shortService" />
        <!-- end feat/local-inference -->

        <!-- Himitsu: EmojiCompat would ask the system font provider (Google Play Services on most
             phones) for an emoji font at startup. Emoji use the system font instead. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>

        <!-- BEGIN disguise activity-aliases: reserved for the feat/disguise track (see ROADMAP.md).
             Other tracks must not add components between these markers. -->
        <!--
          One alias per appearance; AppearanceSwitcher keeps exactly one enabled. Alias names are
          stored by launchers in home screen icons: never rename them after a release.
        -->
        <activity
            android:name=".feature.disguise.DisguiseActivity"
            android:exported="false"
            android:theme="@style/Theme.Disguise" />
        <activity
            android:name=".feature.disguise.settings.DisguiseSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.translationsettings.TranslationSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient" />
        <activity
            android:name=".feature.translationsettings.provideredit.TranslationProviderEditActivity"
            android:exported="false"
            android:theme="@style/Theme.RPClient"
            android:windowSoftInputMode="adjustResize" />
        <activity-alias
            android:name=".launcher.HimitsuLauncher"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".feature.main.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.CalculatorLauncher"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_calculator"
            android:label="@string/disguise_calculator_name"
            android:roundIcon="@mipmap/ic_launcher_calculator"
            android:targetActivity=".feature.disguise.DisguiseActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.CompassLauncher"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_compass"
            android:label="@string/disguise_compass_name"
            android:roundIcon="@mipmap/ic_launcher_compass"
            android:targetActivity=".feature.disguise.DisguiseActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.ConverterLauncher"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_converter"
            android:label="@string/disguise_converter_name"
            android:roundIcon="@mipmap/ic_launcher_converter"
            android:targetActivity=".feature.disguise.DisguiseActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- END disguise activity-aliases -->
    </application>

</manifest>
